# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data & database files (do not commit raw/cleaned datasets or DB dumps)
data/raw/*
!data/raw/.gitkeep
data/cleaned/*
!data/cleaned/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.db
*.sqlite
*.sqlite3
*.sql.gz

# Python & Jupyter artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/